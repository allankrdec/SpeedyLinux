# Padrões do GNOME para o Speedy Linux.
# São apenas valores padrão: o usuário pode alterar e a escolha é mantida.
#
# O teclado NÃO é definido aqui: no live ele vem do parâmetro keyboard-layouts
# do grub.cfg e, no sistema instalado, do teclado escolhido no Calamares
# (/etc/default/keyboard). Definir input-sources aqui faria o GNOME ignorar isso.

[org/gnome/desktop/background]
picture-uri='file:///usr/share/speedy/wallpaper.png'
picture-uri-dark='file:///usr/share/speedy/wallpaper.png'

[org/gnome/desktop/screensaver]
lock-enabled=false

[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/system/locale]
region='pt_BR.UTF-8'

[org/gnome/shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'speedy-installer.desktop']
