componentName: speedy

welcomeStyleCalamares: true
welcomeExpandingLogo: true

windowExpanding: normal
windowSize: 800px,580px
windowPlacement: center

strings:
    productName: Speedy Linux
    shortProductName: Speedy
    # @VERSION_ID@ e @PRETTY_NAME@ vêm do ./os-release (hook 01-speedy)
    version: "@VERSION_ID@"
    shortVersion: "@VERSION_ID@"
    versionedName: "@PRETTY_NAME@"
    shortVersionedName: Speedy Linux
    bootloaderEntryName: Speedy
    productUrl: https://speedysistemas.com.br
    supportUrl: https://speedysistemas.com.br
    knownIssuesUrl: https://speedysistemas.com.br
    releaseNotesUrl: https://speedysistemas.com.br
    donateUrl: https://speedysistemas.com.br

sidebar: widget
navigation: widget

images:
    productLogo: "logo.png"
    productIcon: "logo.png"
    productWelcome: "welcome.png"

slideshow: "show.qml"
slideshowAPI: 2

style:
    SidebarBackground: "#0b3c5d"
    SidebarText: "#FFFFFF"
    SidebarTextCurrent: "#00d4ff"
    SidebarBackgroundCurrent: "#062b40"
